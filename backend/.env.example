# Servidor
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Base de datos SQLite local. La ruta relativa se resuelve desde backend/prisma.
# La aplicación de escritorio define una ruta absoluta en los datos del usuario.
DATABASE_URL="file:./dev.db"

# Cambiar por un secreto aleatorio antes de publicar.
JWT_SECRET=cambia_este_secreto_en_produccion
JWT_EXPIRES_IN=7d

# Usuario inicial. El seed nunca cambia la clave de un usuario existente.
# En producción es obligatorio definir email y contraseña propios.
SEED_EMAIL=rosita@cima.com
SEED_PASSWORD=Cima2025!
SEED_NAME=Rosita

# Datos de ejemplo solo si se ejecuta explícitamente el seed en desarrollo.
SEED_DEMO=false
